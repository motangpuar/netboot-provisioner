@startuml
top to bottom direction
namespace inventory {
    class "BaseConfig" << (S,Aquamarine) >> {
        + Locale string
        + Keymap string
        + Timezone string
        + Hostname string
        + Domain string
        + Username string
        + UserFullname string
        + PasswordHash string
        + MirrorHost string
        + MirrorDir string
        + CallbackHost string
        + MACAddress string
        + SSHPubKey string

    }
    class "CentOSConfig" << (S,Aquamarine) >> {
        + Interface string
        + DiskDevice string
        + ExtraPackages string

    }
    class "CentOSSpecific" << (S,Aquamarine) >> {
        + Initrd string
        + IP string
        + InstallKickStartURL string
        + InstallRepoURL string
        + Stage2 string
        + PreSeedDetails *CentOSConfig

    }
    class "CoreOSSpecifc" << (S,Aquamarine) >> {
        + Initrd string
        + RootFSURL string
        + InstallDev string
        + IgnitionURL string

    }
    class "DebianConfig" << (S,Aquamarine) >> {
        + Interface string
        + DiskDevice string
        + Tasksel string
        + ExtraPackages string
        + Suite string

    }
    class "DebianSpecific" << (S,Aquamarine) >> {
        + Initrd string
        + PreeSeedURL string
        + Hostname string
        + Domain string
        + PreSeedDetails *DebianConfig

    }
    class "MachineObject" << (S,Aquamarine) >> {
        + IP string
        + Cluster string
        + Template string
        + ID string
        + OSName string
        + OSType string
        + Kernel string
        + OSData any
        + Installed bool
        + Role string

        + Generate(ip string, m string, t string, c string, role string, ansibleTemplate string) *MachineObject
        + GetTemplate() string

    }
    class "RHELSpecific" << (S,Aquamarine) >> {
    }
    class "UbuntuConfig" << (S,Aquamarine) >> {
        + Interface string
        + ExtraPackages []string

    }
    class "UbuntuSpecific" << (S,Aquamarine) >> {
        + Initrd string
        + IP string
        + ISOUrl string
        + CloudConfigURL string
        + DS string
        + RootPath string
        + PreSeedDetails *UbuntuConfig

    }
    class "installedMachines" << (S,Aquamarine) >> {
        + Machines <font color=blue>map</font>[string]*MachineObject
        + InstallTime time.Time

    }
    class "ptrMachines" << (S,Aquamarine) >> {
        + Machines <font color=blue>map</font>[string]*MachineObject

    }
}
"inventory.BaseConfig" *-- "extends""inventory.CentOSConfig"
"inventory.BaseConfig" *-- "extends""inventory.DebianConfig"
"inventory.BaseConfig" *-- "extends""inventory.UbuntuConfig"


"inventory.CentOSSpecific""uses" o-- "inventory.CentOSConfig"
"inventory.DebianSpecific""uses" o-- "inventory.DebianConfig"
"inventory.MachineObject""uses" o-- "inventory.any"
"inventory.UbuntuSpecific""uses" o-- "inventory.UbuntuConfig"
"inventory.installedMachines""uses" o-- "inventory.MachineObject"
"inventory.installedMachines""uses" o-- "time.Time"
"inventory.ptrMachines""uses" o-- "inventory.MachineObject"


@enduml
