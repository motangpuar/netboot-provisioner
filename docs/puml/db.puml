@startuml
top to bottom direction
namespace db {
    interface "Client"  {
        + OfferIP() string
        + OfferGateway() string
        + MACAddress() string
        + BootFileUrl() string
        + OSType() string
        + ToMap() <font color=blue>map</font>[string]any
        + GetTemplate() string
        + GetCluster() string
        + GetMachines() inventory.MachineObject

    }
    class "dhcpClients" << (S,Aquamarine) >> {
        - userID string
        - offerIP string
        - offerGateway string
        - macAddress string
        - bootFileUrl string
        - osType string
        - machineObject inventory.MachineObject

        + OfferIP() string
        + OfferGateway() string
        + MACAddress() string
        + BootFileUrl() string
        + OSType() string
        + GetTemplate() string
        + GetCluster() string
        + GetMachines() inventory.MachineObject
        + DHCPClient() *dhcpClients
        + ToMap() <font color=blue>map</font>[string]any

    }
    class "ptrClients" << (S,Aquamarine) >> {
        + Clients <font color=blue>map</font>[string]Client

    }
}

"db.Client" <|-- "implements""db.dhcpClients"

"db.ptrClients""uses" o-- "db.Client"


@enduml
